@page "{id:int}"
@model Task1.Pages.Authors.DeleteModel
@{
	ViewData["Title"] = "Delete Author";
}

<h2>Delete Author</h2>

<div>
    <h4>@Model.Author.FirstName @Model.Author.LastName</h4>
    <p>Birth Date: @Model.Author.BirthDate.ToShortDateString()</p>
</div>

<form method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
