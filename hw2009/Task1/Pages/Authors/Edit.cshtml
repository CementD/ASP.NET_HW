@page "{id:int}"
@model Task1.Pages.Authors.EditModel
@{
	ViewData["Title"] = "Edit Author";
}

<h2>Edit Author</h2>

<form method="post">
	<input type="hidden" asp-for="Author.Id" />
    <div>
        <label asp-for="Author.FirstName"></label>
        <input asp-for="Author.FirstName" class="form-control" />
        <span asp-validation-for="Author.FirstName"></span>
    </div>
    <div>
        <label asp-for="Author.LastName"></label>
        <input asp-for="Author.LastName" class="form-control" />
        <span asp-validation-for="Author.LastName"></span>
    </div>
    <div>
        <label asp-for="Author.BirthDate"></label>
        <input asp-for="Author.BirthDate" type="date" class="form-control" />
        <span asp-validation-for="Author.BirthDate"></span>
    </div>
    <button type="submit" class="btn btn-primary">Update</button>
</form>
