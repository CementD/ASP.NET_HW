@page "{id:int}"
@model Task1.Pages.Books.DeleteModel
@{
    ViewData["Title"] = "Delete Book";
}

<h1>Delete Book</h1>

<h3>Are you sure you want to delete this book?</h3>

<div>
    <h4>@Model.Book.Title</h4>
    <p><strong>ISBN:</strong> @Model.Book.ISBN</p>
    <p><strong>Author:</strong> @Model.Book.Author.FirstName @Model.Book.Author.LastName</p>
    <p><strong>Publish Year:</strong> @Model.Book.PublishYear</p>
</div>

<form method="post">
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
