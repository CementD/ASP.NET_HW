@page
@model Task2.Pages.Orders.AddItemModel
@{
    ViewData["Title"] = "Add Product to Order";
}

<h1>Add Product</h1>

<form method="post">
    <input type="hidden" asp-for="OrderItem.OrderId" value="@Model.OrderId" />

    <div class="form-group">
        <label asp-for="OrderItem.ProductId"></label>
        <select asp-for="OrderItem.ProductId" class="form-control" asp-items="@(new SelectList(Model.Products, "Id", "Name"))"></select>
    </div>

    <div class="form-group mt-2">
        <label asp-for="OrderItem.Quantity"></label>
        <input asp-for="OrderItem.Quantity" class="form-control" />
        <span asp-validation-for="OrderItem.Quantity" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Add</button>
    <a asp-page="Details" asp-route-id="@Model.OrderId" class="btn btn-secondary mt-3">Cancel</a>
</form>
