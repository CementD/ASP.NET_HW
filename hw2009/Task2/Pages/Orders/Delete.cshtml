@page "{id:int}"
@model Task2.Pages.Orders.DeleteModel
@{
    ViewData["Title"] = "Delete Order";
}

<h1>Delete Order</h1>

<h3>Are you sure you want to delete this order?</h3>

<div>
    <p><strong>Customer:</strong> @Model.Order.Customer?.FullName</p>
    <p><strong>Date:</strong> @Model.Order.OrderDate.ToString("dd.MM.yyyy HH:mm")</p>
    <p><strong>Status:</strong> @Model.Order.Status</p>
</div>

<form method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
