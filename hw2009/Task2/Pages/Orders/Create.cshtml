@page
@model Task2.Pages.Orders.CreateModel
@{
    ViewData["Title"] = "Create Order";
}

<h1>Create Order</h1>

<form method="post">
    <div class="form-group">
        <label asp-for="Order.CustomerId"></label>
        <select asp-for="Order.CustomerId" class="form-control" asp-items="@(new SelectList(Model.Customers, "Id", "FullName"))"></select>
        <span asp-validation-for="Order.CustomerId" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <label asp-for="Order.Status"></label>
        <select asp-for="Order.Status" class="form-control" asp-items="Html.GetEnumSelectList<Task2.Models.OrderStatus>()"></select>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Create</button>
    <a asp-page="Index" class="btn btn-secondary mt-3">Cancel</a>
</form>