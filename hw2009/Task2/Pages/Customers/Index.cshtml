@page
@model Task2.Pages.Customers.IndexModel
@{
	ViewData["Title"] = "Customers List";
}

<h1>Customers</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model.Customers)
        {
            <tr>
                <td>@c.FullName</td>
                <td>@c.Email</td>
                <td>@c.Phone</td>
                <td>
                    <a asp-page="Details" asp-route-id="@c.Id">Details</a> |
                    <a asp-page="Edit" asp-route-id="@c.Id">Edit</a> |
                    <a asp-page="Delete" asp-route-id="@c.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
