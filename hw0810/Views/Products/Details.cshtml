@model hw0810.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="max-w-3xl bg-white p-6 rounded shadow">
    <div class="flex gap-6">
        <img src="@Model.ImageUrl ?? " https: //via.placeholder.com/400"" class="w-1/3 rounded" />
        <div>
            <h1 class="text-2xl font-bold">@Model.Name</h1>
            <p class="text-gray-700 mt-2">@Model.Description</p>
            <div class="mt-4 text-blue-600 font-bold">$@Model.Price</div>
            <a class="mt-4 inline-block bg-green-600 text-white px-4 py-2 rounded" href="#">Buy</a>
        </div>
    </div>
</div>
