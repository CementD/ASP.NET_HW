@model IEnumerable<hw0810.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<h2 class="text-2xl font-bold mb-4">Products</h2>

<div class="flex flex-wrap">
    @foreach (var p in Model)
    {
        @await Html.PartialAsync("_ProductCard", p)
    }
</div>

<div class="mt-6">
    <h4 class="font-semibold mb-2">Latest posts (compact)</h4>
    @await Component.InvokeAsync("LatestPosts", new { compact = true })
</div>
