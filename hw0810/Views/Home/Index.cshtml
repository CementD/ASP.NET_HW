@model IEnumerable<hw0810.Models.Product>
@{
    ViewData["Title"] = "Home";
}

<div class="grid grid-cols-3 gap-4">
    <div class="col-span-2">
        <h2 class="text-2xl font-bold mb-4">Products</h2>
        <div class="flex flex-wrap">
            @foreach (var p in Model)
            {
                @await Html.PartialAsync("_ProductCard", p)
            }
        </div>
    </div>

    <div>
        <div class="mb-4">
            <h4 class="font-semibold mb-2">Top Products</h4>
            @await Component.InvokeAsync("TopProducts", new { count = 3 })
        </div>

        <div>
            <h4 class="font-semibold mb-2">Latest Posts</h4>
            @await Component.InvokeAsync("LatestPosts")
        </div>
    </div>
</div>
