@model hw0810.Models.User

<form asp-action="Edit" method="post" class="space-y-3">
    <input type="hidden" asp-for="Id" />
    <div>
        <label class="block text-sm font-medium">Name</label>
        <input asp-for="Name" class="w-full border rounded px-3 py-2" />
        <span asp-validation-for="Name" class="text-red-600 text-sm"></span>
    </div>
    <div>
        <label class="block text-sm font-medium">Email</label>
        <input asp-for="Email" class="w-full border rounded px-3 py-2" />
        <span asp-validation-for="Email" class="text-red-600 text-sm"></span>
    </div>
    <div>
        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded">Save</button>
    </div>
</form>

