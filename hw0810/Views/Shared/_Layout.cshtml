@using hw0810.Models
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - ShopApp</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet" />
</head>
<body class="bg-gray-50">
    <header class="bg-white shadow">
        <div class="max-w-6xl mx-auto p-4 flex items-center justify-between">
            <a class="text-2xl font-bold" asp-controller="Home" asp-action="Index">ShopApp</a>
            @await Html.PartialAsync("_MainMenu", (User)ViewBag.CurrentUser)
        </div>
    </header>

    <div class="max-w-6xl mx-auto mt-6 p-4">
        @if (TempData["Success"] != null)
        {
            <div class="mb-4 px-4 py-3 rounded bg-green-100 text-green-800">@TempData["Success"]</div>
        }
        @RenderBody()
    </div>

    <footer class="mt-12 p-4 text-center text-sm text-gray-600">
        &copy; @DateTime.Now.Year - ShopApp
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
