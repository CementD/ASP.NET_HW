@model hw0810.Models.Product

<div class="w-64 bg-white rounded-lg shadow p-4 m-2">
    <img src="@Model.ImageUrl ?? " https: //via.placeholder.com/300"" class="w-full h-40 object-cover rounded" />
    <h3 class="mt-3 text-lg font-semibold">@Model.Name</h3>
    <p class="text-sm text-gray-600 mt-1">@Model.Description</p>
    <div class="mt-3 flex items-center justify-between">
        <span class="text-blue-600 font-bold">$@Model.Price</span>
        <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="text-sm bg-gray-200 px-3 py-1 rounded hover:bg-gray-300">View</a>
    </div>
</div>

