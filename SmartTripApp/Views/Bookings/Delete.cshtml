@model SmartTripApp.Models.Booking

@{
    ViewData["Title"] = "Delete Booking";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="max-w-xl mx-auto mt-16 bg-white p-8 rounded-xl shadow-lg border border-gray-200 text-center">
    <h2 class="text-2xl font-bold text-red-600 mb-4">Delete Booking</h2>
    <p class="text-gray-700 mb-6">Are you sure you want to delete this booking?</p>

    <div class="bg-gray-50 rounded-lg p-4 mb-6 text-left">
        <p><span class="font-semibold">Tour:</span> @Model.Tour?.Name</p>
        <p><span class="font-semibold">Customer:</span> @Model.CustomerName</p>
        <p><span class="font-semibold">Email:</span> @Model.Email</p>
        <p><span class="font-semibold">Seats:</span> @Model.Seats</p>
        <p><span class="font-semibold">Created:</span> @Model.CreatedAt.ToShortDateString()</p>
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="flex justify-center gap-4">
            <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded-lg transition">
                Confirm Delete
            </button>
            <a asp-action="Index"
               class="border border-gray-400 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-100 transition">
                Cancel
            </a>
        </div>
    </form>
</div>
