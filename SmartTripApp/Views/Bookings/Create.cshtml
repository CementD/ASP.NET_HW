@model SmartTripApp.Models.Booking

@{
    ViewData["Title"] = "Create Booking";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="max-w-lg mx-auto mt-10 bg-white p-8 shadow-lg rounded-xl">
    <h2 class="text-2xl font-semibold text-gray-800 mb-6">Create Booking</h2>

    <form asp-action="Create" class="space-y-5">
        <div asp-validation-summary="ModelOnly" class="text-red-500 mb-3"></div>

        <div>
            <label asp-for="TourId" class="block font-medium mb-1 text-gray-700">Tour</label>
            <select asp-for="TourId" class="w-full border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-400" asp-items="ViewBag.TourId"></select>
        </div>

        <div>
            <label asp-for="CustomerName" class="block font-medium mb-1 text-gray-700">Customer Name</label>
            <input asp-for="CustomerName" class="w-full border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-400" />
            <span asp-validation-for="CustomerName" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="Email" class="block font-medium mb-1 text-gray-700">Email</label>
            <input asp-for="Email" class="w-full border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-400" />
            <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="Seats" class="block font-medium mb-1 text-gray-700">Seats</label>
            <input asp-for="Seats" class="w-full border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-blue-400" />
            <span asp-validation-for="Seats" class="text-red-500 text-sm"></span>
        </div>

        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-lg transition">
            Create Booking
        </button>
    </form>

    <div class="mt-4 text-center">
        <a asp-action="Index" class="text-gray-600 hover:text-blue-600 transition">← Back to List</a>
    </div>
</div>
