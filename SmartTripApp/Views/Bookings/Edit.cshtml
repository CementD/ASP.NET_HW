@model SmartTripApp.Models.Booking

@{
    ViewData["Title"] = "Edit Booking";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="max-w-lg mx-auto mt-10 bg-white p-8 shadow-lg rounded-xl">
    <h2 class="text-2xl font-semibold text-gray-800 mb-6">Edit Booking</h2>

    <form asp-action="Edit" class="space-y-5">
        <input type="hidden" asp-for="Id" />

        <div>
            <label asp-for="TourId" class="block mb-1 text-gray-700">Tour</label>
            <select asp-for="TourId" class="w-full border-gray-300 rounded-lg p-2" asp-items="ViewBag.TourId"></select>
        </div>

        <div>
            <label asp-for="CustomerName" class="block mb-1 text-gray-700">Customer Name</label>
            <input asp-for="CustomerName" class="w-full border-gray-300 rounded-lg p-2" />
        </div>

        <div>
            <label asp-for="Email" class="block mb-1 text-gray-700">Email</label>
            <input asp-for="Email" class="w-full border-gray-300 rounded-lg p-2" />
        </div>

        <div>
            <label asp-for="Seats" class="block mb-1 text-gray-700">Seats</label>
            <input asp-for="Seats" class="w-full border-gray-300 rounded-lg p-2" />
        </div>

        <div>
            <label asp-for="CreatedAt" class="block mb-1 text-gray-700">Created At</label>
            <input asp-for="CreatedAt" class="w-full border-gray-300 rounded-lg p-2" readonly />
        </div>

        <button type="submit" class="w-full bg-amber-600 hover:bg-amber-700 text-white py-2 rounded-lg transition">
            Save Changes
        </button>
    </form>

    <div class="mt-4 text-center">
        <a asp-action="Index" class="text-gray-600 hover:text-blue-600 transition">← Back to List</a>
    </div>
</div>
