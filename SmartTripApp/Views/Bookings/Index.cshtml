@model IEnumerable<SmartTripApp.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="max-w-6xl mx-auto mt-10">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Bookings</h1>
        <a asp-action="Create"
           class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition">
            + Create New
        </a>
    </div>

    <div class="overflow-x-auto bg-white shadow-md rounded-xl">
        <table class="min-w-full text-sm text-left text-gray-700">
            <thead class="bg-gray-100 text-gray-600 uppercase text-xs">
                <tr>
                    <th class="px-4 py-3">Tour</th>
                    <th class="px-4 py-3">Customer</th>
                    <th class="px-4 py-3">Email</th>
                    <th class="px-4 py-3">Seats</th>
                    <th class="px-4 py-3">Created</th>
                    <th class="px-4 py-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-b hover:bg-gray-50 transition">
                        <td class="px-4 py-3 font-medium text-blue-700">
                            <a asp-controller="Tour" asp-action="Details" asp-route-id="@item.Tour.Id">
                                @item.Tour?.Name
                            </a>
                        </td>
                        <td class="px-4 py-3">@item.CustomerName</td>
                        <td class="px-4 py-3">@item.Email</td>
                        <td class="px-4 py-3">@item.Seats</td>
                        <td class="px-4 py-3">@item.CreatedAt.ToShortDateString()</td>
                        <td class="px-4 py-3 text-right space-x-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="text-amber-600 hover:underline">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-blue-600 hover:underline">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="text-red-600 hover:underline">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
