@model List<(string Name, int Count)>

<div class="bg-white rounded-2xl shadow-md p-5 mt-8 max-w-md mx-auto">
    <h3 class="text-2xl font-semibold text-gray-800 mb-4 text-center">🏝️ Top Destinations</h3>
    <ul class="divide-y divide-gray-200">
        @foreach (var d in Model)
        {
            <li class="py-2 flex justify-between items-center">
                <span class="text-gray-800">@d.Name</span>
                <span class="text-gray-500 text-sm">@d.Count bookings</span>
            </li>
        }
    </ul>
</div>
