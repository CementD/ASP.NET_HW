
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartTripApp (Admin)</title>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body class="min-h-screen flex flex-col bg-gray-100 text-gray-900">

    <header class="bg-blue-700 text-white shadow-lg">
        <nav class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
            <a asp-area="" asp-controller="Home" asp-action="Index"
               class="text-2xl font-bold hover:text-blue-200 transition">
                Admin Panel
            </a>
            <ul class="flex space-x-6">
                <li>
                    <a asp-area="" asp-controller="Home" asp-action="Index"
                       class="hover:text-blue-200 font-medium transition">
                        Home
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Destination" asp-action="Index"
                       class="hover:text-blue-200 font-medium transition">
                        Destinations
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Tour" asp-action="Index"
                       class="hover:text-blue-200 font-medium transition">
                        Tours
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Bookings" asp-action="Index"
                       class="hover:text-blue-200 font-medium transition">
                        Bookings
                    </a>
                </li>
                <li>
                    <a asp-controller="Auth" asp-action="Logout"
                       class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded-md transition">
                        Logout
                    </a>
                </li>
            </ul>
        </nav>
    </header>

    <main class="flex-grow max-w-7xl mx-auto px-6 py-8">
        @RenderBody()
    </main>

    <footer class="bg-blue-800 text-blue-100 mt-8">
        <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between text-sm">
            <span>&copy; 2025 SmartTripApp(Admin)</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy" class="hover:text-white">
                Privacy
            </a>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
