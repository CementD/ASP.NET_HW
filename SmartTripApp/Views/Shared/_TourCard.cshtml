@model SmartTripApp.Models.Tour

<div class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-shadow duration-300 p-5 border border-gray-200">
    <h3 class="font-bold text-xl text-gray-900 mb-1">@Model.Name</h3>
    <p class="text-gray-600 mb-2">@Model.Destination?.Name</p>

    <div class="text-sm text-gray-700 mb-3">
        <p>
            <span class="font-medium">From:</span> @Model.StartDate.ToShortDateString()
        </p>
        <p>
            <span class="font-medium">To:</span> @Model.EndDate.ToShortDateString()
        </p>
    </div>

    <p class="text-emerald-600 font-semibold text-lg mb-4">
        💶 @Model.Price €
    </p>

    <a asp-controller="Bookings" asp-action="Create" asp-route-id="@Model.Id"
       class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition">
        Book Now
    </a>
</div>
