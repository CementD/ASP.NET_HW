@{
    ViewData["Title"] = "Welcome";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="flex flex-col justify-center items-center min-h-screen bg-gradient-to-r from-green-200 to-green-400">
    <div class="bg-white rounded-2xl shadow-xl p-10 text-center w-96">
        <h1 class="text-4xl font-extrabold text-green-700 mb-4">Welcome, @User.Identity?.Name!</h1>
        <p class="text-gray-600 mb-6">You are successfully logged in.</p>

        <a asp-controller="Auth" asp-action="Logout"
           class="inline-block bg-red-500 hover:bg-red-600 text-white font-medium px-6 py-3 rounded-xl transition duration-200">
            Logout
        </a>
    </div>
</div>
