@model SmartTripApp.Models.Booking
@{
    var tour = ViewBag.Tour as SmartTripApp.Models.Tour;
    bool isFull = tour.BookedSeats >= tour.MaxSeats;
    bool isPast = tour.EndDate < DateOnly.FromDateTime(DateTime.Today);
    bool canBook = !(isFull || isPast);
}

<div class="max-w-3xl mx-auto bg-white shadow-xl rounded-3xl overflow-hidden mt-10 border border-gray-100">
    <div class="border-t border-gray-200 bg-gradient-to-b from-gray-50 to-white p-8 rounded-b-3xl">

        <form asp-action="BookingForm" asp-controller="BookingSearch" method="post" class="space-y-6">
            <input type="hidden" asp-for="TourId" value="@tour.Id" />

            <div class="flex flex-col md:flex-row gap-6">
                <div class="w-full md:w-1/2">
                    <label asp-for="CustomerName" class="block text-sm font-semibold text-gray-700 mb-1">Full Name</label>
                    <input asp-for="CustomerName"
                           class="w-full border border-gray-300 rounded-xl p-3 text-gray-800 shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition" />
                    <span asp-validation-for="CustomerName" class="text-red-500 text-sm mt-1 block"></span>
                </div>

                <div class="w-full md:w-1/2">
                    <label asp-for="Email" class="block text-sm font-semibold text-gray-700 mb-1">Email</label>
                    <input asp-for="Email"
                           class="w-full border border-gray-300 rounded-xl p-3 text-gray-800 shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition" />
                    <span asp-validation-for="Email" class="text-red-500 text-sm mt-1 block"></span>
                </div>
            </div>

            <div>
                <label asp-for="Seats" class="block text-sm font-semibold text-gray-700 mb-1">Number of Seats</label>
                <input asp-for="Seats" type="number" min="1" max="10"
                       class="w-full border border-gray-300 rounded-xl p-3 text-gray-800 shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition" />
                <span asp-validation-for="Seats" class="text-red-500 text-sm mt-1 block"></span>
            </div>

            <button type="submit"
                    class="w-full py-3 px-4 bg-blue-600 text-white text-lg font-semibold rounded-xl shadow-md hover:bg-blue-700 hover:shadow-xl transition disabled:opacity-50 disabled:cursor-not-allowed mt-10"
                    @(canBook ? "" : "disabled")>
                🚀 Book Now
            </button>

            @if (!canBook)
            {
                <p class="text-center text-gray-500 text-sm mt-3 italic">
                    This tour is either fully booked or no longer available.
                </p>
            }
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
