@model SmartTripApp.Models.Tour
@{
    ViewData["Title"] = $"{Model.Name} - Tour Details";
    bool isSoldOut = Model.BookedSeats >= Model.MaxSeats;
    bool isExpired = Model.EndDate < DateOnly.FromDateTime(DateTime.Today);
}

<div class="max-w-5xl mx-auto p-6 bg-white shadow-2xl rounded-3xl mt-10 border border-gray-100">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="rounded-xl overflow-hidden shadow-md">
            <img src="@Model.Destination.ImageUrl" alt="@Model.Destination.Name" class="w-full h-96 object-cover hover:scale-105 transition-transform duration-500">
        </div>

        <div class="flex flex-col justify-between">
            <div>
                <h1 class="text-3xl font-bold text-gray-800 mb-2">@Model.Name</h1>
                <p class="text-lg text-gray-500 mb-4">
                    📍 @Model.Destination.Name, @Model.Destination.Country
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.Destination.Description))
                {
                    <p class="text-gray-700 mb-4 leading-relaxed">@Model.Destination.Description</p>
                }

                <div class="mb-4 text-sm text-gray-600 space-y-1">
                    <p><span class="font-semibold">Start date:</span> @Model.StartDate.ToString("dd MMM yyyy")</p>
                    <p><span class="font-semibold">End date:</span> @Model.EndDate.ToString("dd MMM yyyy")</p>
                </div>

                <div class="flex items-center gap-4 mb-4">
                    <span class="text-2xl font-semibold text-blue-600">$@Model.Price</span>
                    <span class="text-gray-500 text-sm">
                        @Model.BookedSeats / @Model.MaxSeats seats booked
                    </span>
                </div>

                @if (isExpired)
                {
                    <p class="text-red-600 font-medium mb-2">⚠️ This tour has already ended.</p>
                }
                else if (isSoldOut)
                {
                    <p class="text-red-600 font-medium mb-2">🚫 All seats are booked.</p>
                }
            </div>

            <div class="mt-6">
                @Html.Partial("_BusSeatMap", (Model.MaxSeats, Model.BookedSeats))
            </div>

            <div class="flex gap-4 mt-8">
                <form method="post" asp-controller="BookingSearch" asp-action="BookingForm">
                    <input type="hidden" name="tourId" value="@Model.Id" />
                    <button type="submit"
                            class="px-6 py-3 text-white text-lg font-semibold rounded-xl shadow-md transition
                                   @(isExpired || isSoldOut ? "bg-gray-400 cursor-not-allowed" : "bg-blue-600 hover:bg-blue-700 hover:shadow-lg")"
                            @(isExpired || isSoldOut ? "disabled" : "")>
                        ✈️ Book this Tour
                    </button>
                </form>

                <a asp-controller="BookingSearch" asp-action="Index"
                   class="px-6 py-3 bg-gray-100 hover:bg-gray-200 rounded-xl text-gray-700 font-semibold shadow-sm transition">
                    ← Back to Tours
                </a>
            </div>
        </div>
    </div>
</div>
