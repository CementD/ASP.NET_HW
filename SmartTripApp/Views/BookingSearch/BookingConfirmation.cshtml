@{
    ViewData["Title"] = "Booking Confirmation";
}

<div class="flex flex-col items-center justify-center min-h-[80vh] bg-gradient-to-b from-gray-50 to-gray-100 px-4">
    <div class="bg-white shadow-2xl rounded-3xl p-10 max-w-md w-full text-center border border-gray-100">
        <div class="mx-auto mb-5 flex items-center justify-center w-20 h-20 bg-green-100 rounded-full">
            <svg class="w-12 h-12 text-green-600 animate-pulse" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
        </div>

        <h1 class="text-3xl font-extrabold text-gray-800 mb-3">Booking Confirmed!</h1>
        <p class="text-gray-600 mb-8 leading-relaxed">
            🎉 Thank you for your reservation. A confirmation email has been sent to your address.
        </p>

        <a asp-controller="BookingSearch" asp-action="Index"
           class="inline-block px-8 py-3 rounded-xl bg-blue-600 text-white font-semibold shadow-md hover:bg-blue-700 hover:shadow-lg transition">
            ← Back to Tours
        </a>
    </div>
</div>
