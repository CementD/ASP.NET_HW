@model SmartTripApp.Models.Tour

@{
    ViewData["Title"] = "Tour Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="text-2xl font-bold mb-6">Tour Details</h1>

<div class="bg-white p-6 rounded-2xl shadow-md max-w-lg mx-auto space-y-4">
    <div class="grid grid-cols-2 gap-4">
        <div class="font-semibold text-gray-700">Destination:</div>
        <div>
            <a asp-controller="Destination" asp-action="Details" asp-route-id="@Model.Destination.Id" class="text-blue-600 hover:underline">
                @Model.Destination.Name
            </a>
        </div>

        <div class="font-semibold text-gray-700">Name:</div>
        <div>@Model.Name</div>

        <div class="font-semibold text-gray-700">Start Date:</div>
        <div>@Model.StartDate.ToShortDateString()</div>

        <div class="font-semibold text-gray-700">End Date:</div>
        <div>@Model.EndDate.ToShortDateString()</div>

        <div class="font-semibold text-gray-700">Price:</div>
        <div>€@Model.Price</div>

        <div class="font-semibold text-gray-700">Max Seats:</div>
        <div>@Model.MaxSeats</div>

        <div class="font-semibold text-gray-700">Booked Seats:</div>
        <div>@Model.BookedSeats</div>
    </div>
</div>

<div class="mt-4 text-center">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="text-blue-600 hover:underline">Edit</a> |
    <a asp-action="Index" class="text-blue-600 hover:underline">Back to List</a>
</div>
