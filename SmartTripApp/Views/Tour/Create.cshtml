@model SmartTripApp.Models.Tour

@{
    ViewData["Title"] = "Create Tour";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="text-2xl font-bold mb-6">Create Tour</h1>

<form asp-action="Create" method="post" class="bg-white p-6 rounded-2xl shadow-md max-w-lg mx-auto space-y-4">
    <div asp-validation-summary="ModelOnly" class="text-red-500"></div>

    <div>
        <label asp-for="DestinationId" class="block font-semibold text-gray-700 mb-1"></label>
        <select asp-for="DestinationId" class="w-full border border-gray-300 rounded-xl p-2" asp-items="ViewBag.DestinationId"></select>
        <span asp-validation-for="DestinationId" class="text-red-500 text-sm"></span>
    </div>

    <div>
        <label asp-for="Name" class="block font-semibold text-gray-700 mb-1"></label>
        <input asp-for="Name" class="w-full border border-gray-300 rounded-xl p-2" />
        <span asp-validation-for="Name" class="text-red-500 text-sm"></span>
    </div>

    <div class="grid grid-cols-2 gap-4">
        <div>
            <label asp-for="StartDate" class="block font-semibold text-gray-700 mb-1"></label>
            <input asp-for="StartDate" type="date" class="w-full border border-gray-300 rounded-xl p-2" />
            <span asp-validation-for="StartDate" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="EndDate" class="block font-semibold text-gray-700 mb-1"></label>
            <input asp-for="EndDate" type="date" class="w-full border border-gray-300 rounded-xl p-2" />
            <span asp-validation-for="EndDate" class="text-red-500 text-sm"></span>
        </div>
    </div>

    <div>
        <label asp-for="Price" class="block font-semibold text-gray-700 mb-1"></label>
        <input asp-for="Price" class="w-full border border-gray-300 rounded-xl p-2" />
        <span asp-validation-for="Price" class="text-red-500 text-sm"></span>
    </div>

    <div>
        <label asp-for="MaxSeats" class="block font-semibold text-gray-700 mb-1"></label>
        <input asp-for="MaxSeats" class="w-full border border-gray-300 rounded-xl p-2" />
        <span asp-validation-for="MaxSeats" class="text-red-500 text-sm"></span>
    </div>

    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-xl transition font-semibold">
        Create
    </button>
</form>

<div class="mt-4 text-center">
    <a asp-action="Index" class="text-blue-600 hover:underline">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
