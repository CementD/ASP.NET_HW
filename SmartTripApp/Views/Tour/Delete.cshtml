@model SmartTripApp.Models.Tour

@{
    ViewData["Title"] = "Delete Tour";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="text-2xl font-bold mb-6">Delete Tour</h1>

<div class="bg-white p-6 rounded-2xl shadow-md max-w-lg mx-auto space-y-4">
    <p class="text-gray-700">Are you sure you want to delete this tour?</p>

    <div class="grid grid-cols-2 gap-4">
        <div class="font-semibold text-gray-700">Destination:</div>
        <div>@Model.Destination.Name</div>

        <div class="font-semibold text-gray-700">Name:</div>
        <div>@Model.Name</div>

        <div class="font-semibold text-gray-700">Start Date:</div>
        <div>@Model.StartDate.ToShortDateString()</div>

        <div class="font-semibold text-gray-700">End Date:</div>
        <div>@Model.EndDate.ToShortDateString()</div>

        <div class="font-semibold text-gray-700">Price:</div>
        <div>€@Model.Price</div>

        <div class="font-semibold text-gray-700">Max Seats:</div>
        <div>@Model.MaxSeats</div>

        <div class="font-semibold text-gray-700">Booked Seats:</div>
        <div>@Model.BookedSeats</div>
    </div>

    <form asp-action="Delete" method="post" class="mt-4 flex gap-4">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="bg-red-600 hover:bg-red-700 text-white py-2 px-4 rounded-xl transition font-semibold">
            Delete
        </button>
        <a asp-action="Index" class="bg-gray-200 hover:bg-gray-300 text-gray-800 py-2 px-4 rounded-xl transition text-center">Cancel</a>
    </form>
</div>
