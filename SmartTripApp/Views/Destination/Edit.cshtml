@model SmartTripApp.Models.Destination

@{
    ViewData["Title"] = "Edit Destination";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="max-w-2xl mx-auto bg-white shadow-md rounded-lg p-6 mt-10">
    <h1 class="text-2xl font-semibold text-gray-800 mb-6 text-center">Edit Destination</h1>

    <form asp-action="Edit" method="post" class="space-y-5">
        <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>

        <input type="hidden" asp-for="Id" />

        <div>
            <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Name"
                   class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none" />
            <span asp-validation-for="Name" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="Country" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <select asp-for="Country"
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none">
                <option value="">---</option>
                @foreach (var country in ViewBag.Countries)
                {
                    <option value="@country" selected="@(country == Model.Country ? "selected" : null)">
                        @country
                    </option>
                }
            </select>
            <span asp-validation-for="Country" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <textarea asp-for="Description"
                      rows="4"
                      class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none"></textarea>
            <span asp-validation-for="Description" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="ImageUrl" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="ImageUrl"
                   class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none" />
            <span asp-validation-for="ImageUrl" class="text-red-500 text-sm"></span>

            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <div class="mt-3">
                    <p class="text-sm text-gray-600 mb-1">Current Image:</p>
                    <img src="@Model.ImageUrl" alt="Destination image" class="w-full max-h-60 object-cover rounded-lg border border-gray-200" />
                </div>
            }
        </div>

        <div class="flex justify-between items-center pt-4">
            <a asp-action="Index"
               class="px-5 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition">Back</a>

            <button type="submit"
                    class="px-6 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition">
                Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
