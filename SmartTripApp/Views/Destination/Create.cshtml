@model SmartTripApp.Models.Destination
@{
    ViewData["Title"] = "Create Destination";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="max-w-3xl mx-auto bg-white mt-10 shadow-xl rounded-2xl p-8">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">Add New Destination</h1>

    <form asp-action="Create" class="space-y-6">
        <div>
            <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1">Name</label>
            <input asp-for="Name" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-blue-500" />
            <span asp-validation-for="Name" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="Country" class="block text-sm font-medium text-gray-700 mb-1">Country</label>
            <select asp-for="Country" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-blue-500">
                <option value="">---</option>
                @foreach (var c in ViewBag.Countries)
                {
                    <option value="@c">@c</option>
                }
            </select>
            <span asp-validation-for="Country" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
            <textarea asp-for="Description" class="w-full border border-gray-300 rounded-lg p-3 h-28 focus:ring-2 focus:ring-blue-500"></textarea>
            <span asp-validation-for="Description" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="ImageUrl" class="block text-sm font-medium text-gray-700 mb-1">Image URL</label>
            <input asp-for="ImageUrl" class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-blue-500" />
            <span asp-validation-for="ImageUrl" class="text-red-500 text-sm"></span>
        </div>

        <div class="flex justify-between mt-8">
            <a asp-action="Index" class="text-gray-600 hover:underline">← Back to List</a>
            <button type="submit"
                    class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 shadow-md transition">
                Create
            </button>
        </div>
    </form>
</div>
