@model SmartTripApp.Models.Destination
@{
    ViewData["Title"] = "Destination Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="max-w-4xl mx-auto bg-white mt-10 shadow-xl rounded-2xl p-8">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">@Model.Name</h1>

    <img src="@Model.ImageUrl" alt="@Model.Name"
         class="w-full max-h-96 object-cover rounded-xl shadow-md mb-6" />

    <div class="space-y-2 text-gray-700">
        <p><span class="font-semibold">Country:</span> @Model.Country</p>
        <p><span class="font-semibold">Description:</span> @Model.Description</p>
    </div>

    @if (Model.Tours?.Any() == true)
    {
        <div class="mt-6">
            <h3 class="font-semibold text-gray-800 mb-2">Tours:</h3>
            <ul class="space-y-1 text-blue-600">
                @foreach (var t in Model.Tours)
                {
                    <li>
                        <a asp-controller="Tour" asp-action="Details" asp-route-id="@t.Id"
                           class="hover:underline">@t.Name</a>
                    </li>
                }
            </ul>
        </div>
    }

    <div class="flex justify-between mt-8">
        <a asp-action="Index" class="text-gray-600 hover:underline">← Back to List</a>
        <a asp-action="Edit" asp-route-id="@Model.Id"
           class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
            Edit
        </a>
    </div>
</div>
