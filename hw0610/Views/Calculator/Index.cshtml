@{
    ViewData["Title"] = "Calculator";
}

<h2 class="text-2xl font-bold mb-4">Calculator</h2>

<form method="post" class="space-y-3">
    <input type="number" name="a" placeholder="First number" class="border p-2 rounded w-full" required />
    <input type="number" name="b" placeholder="Second number" class="border p-2 rounded w-full" required />

    <div class="space-x-2">
        <button type="submit" name="operation" value="add" class="bg-blue-500 text-white px-3 py-1 rounded">Add</button>
        <button type="submit" name="operation" value="divide" class="bg-green-500 text-white px-3 py-1 rounded">Divide</button>
    </div>
</form>

@if (ViewBag.Result != null)
{
    <p class="mt-4 font-semibold">@ViewBag.Result</p>
}
